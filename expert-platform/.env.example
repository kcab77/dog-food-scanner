# ── Supabase (server-side only) ──────────────────────────────────────────────
# The app + ingestion use the SERVICE ROLE key (bypasses RLS). NEVER expose it
# to the browser or commit the real .env. Copy from: Supabase dashboard ->
# Project Settings -> API -> service_role (secret).
SUPABASE_URL=https://fqafctdxcrtrnhwpohlf.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Models ───────────────────────────────────────────────────────────────────
VOYAGE_API_KEY=          # embeddings (voyage-3, 1024-dim) — must match schema
ANTHROPIC_KEY=           # generation (claude-sonnet-5)

# ── Retrieval tuning (optional) ──────────────────────────────────────────────
RELEVANCE_FLOOR=0.40     # below this cosine similarity -> refusal path (tuned)
MATCH_COUNT=8

# ── Only for --youtube ingestion ─────────────────────────────────────────────
YT_LANG=en                # caption track language for --youtube (default en)
YOUTUBE_API_KEY=
